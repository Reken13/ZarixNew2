Options -MultiViews
RewriteEngine On
RewriteBase /

# MIME types
AddType font/woff2 .woff2
AddType font/woff .woff

# Cache headers
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|woff|ttf)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|jpeg|webp|svg|ico)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "max-age=3600, public, must-revalidate"
  </FilesMatch>
</IfModule>

# Custom error pages
ErrorDocument 404 /404.html

# Redirect www to non-www (canonical domain)
RewriteCond %{HTTP_HOST} ^www\.zarix\.site [NC]
RewriteRule ^ https://zarix.site%{REQUEST_URI} [R=301,L,NE]

# Redirect .html extension to clean URL (301 for SEO)
RewriteCond %{THE_REQUEST} \s/([^.]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# Redirect trailing slash on non-directory paths
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L,NE]

# Internally serve .html for clean URLs (no redirect, transparent)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^ %{REQUEST_URI}.html [L]
